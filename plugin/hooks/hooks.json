{
  "description": "boardwright: project status at session start; design history after each edit; one editor at a time. All only inside a boardwright project.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\" 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/edit_hooks.py\" prompt 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/edit_hooks.py\" prompt 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|mcp__plugin_boardwright_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/edit_hooks.py\" pre 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/edit_hooks.py\" pre 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|mcp__plugin_boardwright_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/edit_hooks.py\" post 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/edit_hooks.py\" post 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/edit_hooks.py\" end 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/edit_hooks.py\" end 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/edit_hooks.py\" stop 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/edit_hooks.py\" stop 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
