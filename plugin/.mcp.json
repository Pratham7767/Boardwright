{
  "mcpServers": {
    "boardwright": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/scripts/bw_mcp.py"
      ]
    },
    "kicad-live": {
      "type": "stdio",
      "command": "kicad-buddy",
      "args": []
    },
    "kicad-schematic": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "mcp-server-kicad==0.21.1",
        "mcp-server-kicad-schematic"
      ]
    }
  }
}
