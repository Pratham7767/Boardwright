(version 1)

# Copper stays clear of the M3 mounting holes (room for a screw head).
(rule "mounting_hole_keepout"
  (constraint hole_clearance (min 1.5mm))
  (condition "A.memberOfFootprint('H?')"))

# Power nets are never routed thinner than 0.3 mm.
(rule "power_min_width"
  (constraint track_width (min 0.3mm))
  (condition "A.NetClass == 'Power'"))

# USB data lines keep to their class width or wider.
(rule "usb_min_width"
  (constraint track_width (min 0.2mm))
  (condition "A.NetClass == 'USB'"))
